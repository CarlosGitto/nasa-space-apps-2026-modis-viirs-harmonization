# Copy to etl/.env and fill in. etl/.env is git-ignored: never commit the key.

# FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/) as an Airflow connection.
AIRFLOW_CONN_FIRMS_DEFAULT='{"conn_type": "http", "host": "firms.modaps.eosdis.nasa.gov", "password": "YOUR_MAP_KEY"}'

# Weather comes from NASA POWER: no credentials needed.

# Area every ingest run requests by default: "world" or a "west,south,east,north" bbox.
# Local dev uses South America, the same bbox `make etl-seed-dev` loads (DEV_AREA in the Makefile).
# The weather DAG uses the same area. Set WEATHER_AREA only to give weather a different
# one; keep them equal otherwise (see data/README.md, "Changing the region or the dates").
FIRMS_AREA=-82,-56,-34,13
# WEATHER_AREA=-82,-56,-34,13
# The whole world: FIRMS_AREA=world (then `make etl-restart` and the seeds with DEV_AREA=world,
# see the Makefile). Hours of downloads and ~25-35 GB of fire data.

# Weather keeps only the grid cells near fires ("fires", the default: the whole world in a
# few GB) or every cell of the area ("all": billions of rows for the world).
# WEATHER_KEEP=fires
